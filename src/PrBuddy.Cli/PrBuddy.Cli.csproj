<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PrBuddy.Core\PrBuddy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>prbuddy</AssemblyName>
    <RootNamespace>PrBuddy.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>prbuddy</ToolCommandName>
    <PackageId>PrBuddy</PackageId>
    <Version>0.1.0</Version>
    <Authors>anefiox</Authors>
    <Description>A deterministic sanity check for C# pull requests with an optional agent review and benchmarking mode.</Description>
    <PackageTags>code-review;pull-request;roslyn;static-analysis;dotnet-tool</PackageTags>
    <RepositoryUrl>https://github.com/anefiox/pr-buddy</RepositoryUrl>
    <PackageProjectUrl>https://github.com/anefiox/pr-buddy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Agents\pr-review\SKILL.md" LogicalName="PrBuddy.AgentSkill.md" />
    <EmbeddedResource Include="Agents\pr-review\decision.json" LogicalName="PrBuddy.AgentDecision.json" />
  </ItemGroup>

</Project>
